class BankAccount:
 def __init__(self,holder,balance):
    self.holder = holder 
    self.balance = balance
    
  def deposite(self, amount):
    self.balance += amount

  def withdraw(self, amount):
    if self.balance < amount:
      print("insufficient balance")
    else:
      self.balance -= amount

  def show_balance(self):
    print(self.balance)

